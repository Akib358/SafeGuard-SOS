<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="#161622"
    android:orientation="vertical"
    android:padding="16dp">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🚨 Active SOS Incidents &amp; Rescue Hub"
        android:textColor="#FFFFFF"
        android:textSize="17sp"
        android:textStyle="bold" />

    <!-- Top Section: Check Your SOS / Manage Own SOS -->
    <androidx.cardview.widget.CardView
        android:id="@+id/cardMySOSSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="12dp"
        app:cardBackgroundColor="#2A1B1B"
        app:cardCornerRadius="12dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="12dp">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/tvMySosStatusHeader"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="🛡️ Check Your SOS"
                    android:textColor="#FF5252"
                    android:textSize="14sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvMySosBadge"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="#D50000"
                    android:paddingHorizontal="6dp"
                    android:paddingVertical="2dp"
                    android:text="ACTIVE"
                    android:textColor="#FFFFFF"
                    android:textSize="10sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvMySosDescription"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="You have triggered an active SOS. If you are safe now, describe what happened and mark as safe."
                android:textColor="#C0C0D0"
                android:textSize="12sp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnManageMySOS"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:backgroundTint="#00E676"
                android:text="✍️ Describe Incident &amp; Mark I'm Safe"
                android:textColor="#000000"
                android:textSize="13sp"
                android:textStyle="bold" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="14dp"
        android:text="Ongoing Alerts (Tap any to join live rescue chat):"
        android:textColor="#8F8FA0"
        android:textSize="12sp"
        android:textStyle="bold" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvActiveSOSList"
        android:layout_width="match_parent"
        android:layout_height="240dp"
        android:layout_marginTop="8dp" />

    <TextView
        android:id="@+id/tvEmptyActiveSos"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:gravity="center"
        android:text="✅ No active SOS alerts in your perimeter."
        android:textColor="#00E676"
        android:textSize="13sp"
        android:visibility="gone" />

    <com.google.android.material.button.MaterialButton
        android:id="@+id/btnCloseHub"
        style="@style/Widget.MaterialComponents.Button.TextButton"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="end"
        android:layout_marginTop="4dp"
        android:text="Close"
        android:textColor="#A0A0B0" />
</LinearLayout>