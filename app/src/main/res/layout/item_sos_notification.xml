<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardNotification"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="12dp"
    android:layout_marginVertical="6dp"
    app:cardBackgroundColor="#1A1A27"
    app:cardCornerRadius="14dp"
    app:cardElevation="3dp"
    app:strokeColor="#2C2C40"
    app:strokeWidth="1dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="14dp">

        <!-- Top Header: Badge + Full Date, Year and Time -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/tvTagBadge"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="#D50000"
                android:paddingHorizontal="8dp"
                android:paddingVertical="3dp"
                android:text="🚨 GUARDIAN ALERT"
                android:textColor="#FFFFFF"
                android:textSize="10sp"
                android:textStyle="bold" />

            <View
                android:layout_width="0dp"
                android:layout_height="1dp"
                android:layout_weight="1" />

            <!-- Date, Year & Time at Top -->
            <TextView
                android:id="@+id/tvNotifTime"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="07 Oct 2026, 02:30 AM"
                android:textColor="#A0A0BA"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Notification Title -->
        <TextView
            android:id="@+id/tvNotifTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Someone is in critical danger!"
            android:textColor="#FFFFFF"
            android:textSize="15sp"
            android:textStyle="bold" />

        <!-- Phone & Distance Info -->
        <TextView
            android:id="@+id/tvNotifPhone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:text="Sender: 017XXXXXXXX • Distance: Calculating..."
            android:textColor="#8F8FA8"
            android:textSize="12sp" />

        <!-- Full Story / Incident Description / Safe Note -->
        <TextView
            android:id="@+id/tvNotifDesc"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:background="#222234"
            android:padding="8dp"
            android:text="📝 Incident Status: Emergency SOS active."
            android:textColor="#E0E0F0"
            android:textSize="12sp" />

        <!-- Message count info -->
        <TextView
            android:id="@+id/tvNotifChatInfo"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="💬 0 Rescue Discussion Messages"
            android:textColor="#00E676"
            android:textSize="12sp"
            android:textStyle="bold" />

        <!-- Action Buttons -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:gravity="end"
            android:orientation="horizontal">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnJoinChat"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:layout_marginEnd="8dp"
                android:backgroundTint="#2E2E48"
                android:text="💬 Rescue Chat"
                android:textColor="#448AFF"
                android:textSize="11sp"
                app:cornerRadius="10dp" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnNavigateRoute"
                style="@style/Widget.Material3.Button.TonalButton"
                android:layout_width="wrap_content"
                android:layout_height="38dp"
                android:backgroundTint="#2E2E48"
                android:text="📍 Shortest Route"
                android:textColor="#00E676"
                android:textSize="11sp"
                app:cornerRadius="10dp" />
        </LinearLayout>

    </LinearLayout>
</com.google.android.material.card.MaterialCardView>